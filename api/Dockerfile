# The API, its card data, and its tests. Build from the repo root: the image needs
# `data/pilot-864/`, which lives outside `api/`.
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /srv

# Dependencies first, so a source edit does not reinstall them.
COPY api/pyproject.toml api/README.md* ./api/
COPY api/src ./api/src
RUN pip install -e "./api[dev]"

# The pool and the card index. Read-only at runtime; regenerated by
# `tools/gen_card_index.py` on the host, never in the container.
COPY data/pilot-864 ./data/pilot-864
COPY api/tests ./api/tests

# Paths are stated, not inferred from where the package happens to sit.
ENV AI_DRAW_POOL=/srv/data/pilot-864/pool.txt \
    AI_DRAW_CARDS=/srv/data/pilot-864/cards.json \
    AI_DRAW_DB=/var/lib/ai-draw/jobs.db

# The job database is the one thing that must outlive the container (ADR-0005).
VOLUME ["/var/lib/ai-draw"]
EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
    CMD python -c "import urllib.request,sys; \
sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=2).status == 200 else 1)"

CMD ["uvicorn", "ai_draw_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
